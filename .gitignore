# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# local planning notes
/notes/

# stress-test fixtures, harness, evidence (see notes/20260905[Stress test protocol].md)
/public/stress_test/
/public/stress_test/**/*.js
/public/stress_test/**/*.cjs
/public/stress_test/harness.js
/public/stress_test/bench-parse.cjs
/public/stress_test/hot-users.cjs

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
