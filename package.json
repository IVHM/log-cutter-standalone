{
  "name": "json-log-explorer",
  "version": "0.1.0",
  "private": true,
  "author": "LogCutter",
  "description": "Local-first workspace for investigating JSON logs",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev --port 43123 --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/serve-static.cjs",
    "desktop": "electron .",
    "dist": "npm run build && electron-builder --win portable",
    "lint": "eslint"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "build": {
    "appId": "dev.logcutter.app",
    "productName": "LogCutter",
    "npmRebuild": false,
    "electronLanguages": ["en-US"],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "!**/node_modules/**"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "out"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "LogCutter.exe"
    }
  },
  "dependencies": {
    "@xyflow/react": "^12.11.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.5",
    "lucide-react": "^1.38.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.19.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.1.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
